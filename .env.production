# Firebase Configuration (Production)
FIREBASE_API_KEY=your_production_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_production_project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your_production_project-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your_production_project_id
FIREBASE_STORAGE_BUCKET=your_production_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_production_messaging_sender_id
FIREBASE_APP_ID=your_production_app_id
FIREBASE_MEASUREMENT_ID=your_production_measurement_id

# Google Maps API (Production)
GOOGLE_MAPS_API_KEY=your_production_google_maps_api_key

# Application Configuration
NODE_ENV=production
APP_NAME=PDPA Self Assessment Tool
APP_VERSION=1.0.0

# Build Configuration
BUILD_MODE=production
ENABLE_SOURCE_MAPS=false
ENABLE_HOT_RELOAD=false 