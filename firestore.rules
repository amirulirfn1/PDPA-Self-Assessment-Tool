rules_version = "2";
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isSignedIn() &&
        (request.auth.token.role == "owner" || request.auth.token.role == "admin");
    }

    function memberDoc(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function isActiveMember(orgId) {
      return isSignedIn() &&
        memberDoc(orgId).exists() &&
        memberDoc(orgId).data.status == "active";
    }

    function hasOrgRole(orgId, roles) {
      return isActiveMember(orgId) && memberDoc(orgId).data.role in roles;
    }

    function canWriteOrgData(orgId) {
      return hasOrgRole(orgId, ["owner", "admin", "assessor"]);
    }

    function canAdminOrg(orgId) {
      return hasOrgRole(orgId, ["owner", "admin"]);
    }

    match /organizations/{orgId} {
      allow read: if isActiveMember(orgId);
      allow create: if isSignedIn();
      allow update, delete: if canAdminOrg(orgId);

      match /members/{uid} {
        allow read: if isActiveMember(orgId);
        allow create, update, delete: if canAdminOrg(orgId);
      }
    }

    match /users/{uid} {
      allow read, create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /control_library/{controlId} {
      allow read: if isSignedIn();
      allow write: if isPlatformAdmin();
    }

    match /assessment_templates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isPlatformAdmin();
    }

    match /assessment_runs/{runId} {
      allow read: if isSignedIn() && isActiveMember(resource.data.orgId);
      allow create: if isSignedIn() && canWriteOrgData(request.resource.data.orgId);
      allow update: if isSignedIn() && canWriteOrgData(resource.data.orgId);
      allow delete: if false;
    }

    match /assessments/{assessmentId} {
      allow read: if isSignedIn() && isActiveMember(resource.data.orgId);
      allow create: if isSignedIn() && canWriteOrgData(request.resource.data.orgId);
      allow update: if isSignedIn() && canWriteOrgData(resource.data.orgId);
      allow delete: if false;
    }

    match /action_plans/{planId} {
      allow read: if isSignedIn() && isActiveMember(resource.data.orgId);
      allow create: if isSignedIn() && canWriteOrgData(request.resource.data.orgId);
      allow update: if isSignedIn() && canWriteOrgData(resource.data.orgId);
      allow delete: if false;
    }

    match /evidence_items/{evidenceId} {
      allow read: if isSignedIn() && isActiveMember(resource.data.orgId);
      allow create: if isSignedIn() && canWriteOrgData(request.resource.data.orgId);
      allow update: if isSignedIn() && canWriteOrgData(resource.data.orgId);
      allow delete: if false;
    }

    match /data_inventory/{recordId} {
      allow read: if isSignedIn() && isActiveMember(resource.data.orgId);
      allow create: if isSignedIn() && canWriteOrgData(request.resource.data.orgId);
      allow update: if isSignedIn() && canWriteOrgData(resource.data.orgId);
      allow delete: if false;
    }

    match /data_flows/{flowId} {
      allow read: if isSignedIn() && isActiveMember(resource.data.orgId);
      allow create: if isSignedIn() && canWriteOrgData(request.resource.data.orgId);
      allow update: if isSignedIn() && canWriteOrgData(resource.data.orgId);
      allow delete: if false;
    }

    match /notices/{noticeId} {
      allow read: if isSignedIn() && isActiveMember(resource.data.orgId);
      allow create: if isSignedIn() && canWriteOrgData(request.resource.data.orgId);
      allow update: if isSignedIn() && canWriteOrgData(resource.data.orgId);
      allow delete: if false;
    }

    match /incidents/{incidentId} {
      allow read: if isSignedIn() && isActiveMember(resource.data.orgId);
      allow create: if isSignedIn() && canWriteOrgData(request.resource.data.orgId);
      allow update: if isSignedIn() && canWriteOrgData(resource.data.orgId);
      allow delete: if false;
    }

    match /compliance_tasks/{taskId} {
      allow read: if isSignedIn() && isActiveMember(resource.data.orgId);
      allow create: if isSignedIn() && canWriteOrgData(request.resource.data.orgId);
      allow update: if isSignedIn() && canWriteOrgData(resource.data.orgId);
      allow delete: if false;
    }

    match /audit_events/{eventId} {
      allow read: if isSignedIn() && isActiveMember(resource.data.orgId);
      allow write: if false;
    }

    match /feedback_legacy/{feedbackId} {
      allow read: if isSignedIn() && canAdminOrg(resource.data.orgId);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
